# Kopiere diese Datei nach ".env" (nur auf deinem eigenen Computer!) und trage
# deine Alpaca-PAPER-Schluessel ein. Die Datei .env wird nie committet.
APCA_API_KEY_ID=dein_paper_key_id
APCA_API_SECRET_KEY=dein_paper_secret_key
# Standard ist das Paper-Konto. Nicht aendern!
# APCA_BASE_URL=https://paper-api.alpaca.markets
